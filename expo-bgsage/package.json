{
  "name": "expo-bgsage",
  "version": "0.1.0",
  "description": "Expo native module wrapping the bgsage backgammon engine (stage11 backgame_pair_phased).",
  "license": "MPL-2.0",
  "author": "softwarebyze",
  "keywords": [
    "expo",
    "backgammon",
    "bgsage"
  ],
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json"
  },
  "peerDependencies": {
    "expo": "*",
    "react-native": "*"
  },
  "dependencies": {
    "@expo/config-plugins": "58.0.13",
    "expo-modules-core": "58.1.0",
    "xcode": "3.0.1"
  },
  "expo": {
    "autolinking": {
      "nativeModules": [
        "Bgsage"
      ]
    }
  }
}
