{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "ignoreDeprecations": "6.0",
    "types": [
      "node"
    ],
    "baseUrl": ".",
    "jsx": "react-native",
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@env": [
        "env.ts"
      ]
    },
    "checkJs": true,
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "app.config.ts",
    "env.ts",
    "uniwind-env.d.ts",
    ".expo/types/**/*.ts",
    "expo-env.d.ts"
  ],
  "exclude": [
    "node_modules",
    "babel.config.js",
    "metro.config.js",
    "docs",
    "cli",
    "android",
    "ios",
    ".agents",
    "lint-staged.config.js",
    "**/*.test.ts",
    "**/*.test.tsx"
  ]
}