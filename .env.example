# Application Environment (development | preview | production)
EXPO_PUBLIC_APP_ENV=development

# Optional — App Store numeric ID for Settings → Rate on iOS (production only)
# EXPO_PUBLIC_APP_STORE_ID=6780139011

# Store listing contact (used before eas metadata:push if you switch to store.config.js)
# APPLE_REVIEW_PHONE=+1 555 123 4567

# --- GitHub Actions secrets (NOT .env vars — add in repo Settings) ---
# EXPO_TOKEN              → https://expo.dev/settings/access-tokens
# MAESTRO_CLOUD_API_KEY   → https://cloud.mobile.dev/ci-integration/github-actions#add-your-api-key-secret
# GitHub: Settings → Secrets and variables → Actions → New repository secret

# --- Branding (after clone) ---
# Replace assets/brand/icon-source.png + edit assets/brand/brand.config.json
# Rebuild dev client: pnpm build:development:android:local (or :ios:local)
