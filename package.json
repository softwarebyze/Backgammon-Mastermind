{
  "name": "backgammonmastermind",
  "version": "0.0.1",
  "private": true,
  "packageManager": "pnpm@10.12.3",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/softwarebyze/Backgammon-Mastermind.git"
  },
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "prebuild": "pnpm expo prebuild",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "xcode": "xed -b ios",
    "doctor": "npx expo-doctor@latest",
    "preinstall": "npx only-allow pnpm",
    "start:preview": "cross-env EXPO_PUBLIC_APP_ENV=preview pnpm run start",
    "prebuild:preview": "cross-env EXPO_PUBLIC_APP_ENV=preview STRICT_ENV_VALIDATION=1 pnpm run prebuild",
    "prebuild:development": "cross-env EXPO_PUBLIC_APP_ENV=development STRICT_ENV_VALIDATION=1 pnpm run prebuild",
    "android:preview": "cross-env EXPO_PUBLIC_APP_ENV=preview pnpm run android",
    "ios:preview": "cross-env EXPO_PUBLIC_APP_ENV=preview pnpm run ios",
    "start:production": "cross-env EXPO_PUBLIC_APP_ENV=production pnpm run start",
    "prebuild:production": "cross-env EXPO_PUBLIC_APP_ENV=production STRICT_ENV_VALIDATION=1 pnpm run prebuild",
    "android:production": "cross-env EXPO_PUBLIC_APP_ENV=production pnpm run android",
    "ios:production": "cross-env EXPO_PUBLIC_APP_ENV=production pnpm run ios",
    "build:development:ios": "eas build --profile development --platform ios",
    "build:development:android": "eas build --profile development --platform android",
    "build:development": "eas build --profile development --platform all",
    "build:development:ios:local": "eas build --profile development --platform ios --local",
    "build:development:android:local": "eas build --profile development --platform android --local",
    "build:development:local": "eas build --profile development --platform all --local",
    "build:preview:ios": "eas build --profile preview --platform ios",
    "build:preview:android": "eas build --profile preview --platform android",
    "build:preview:ios:local": "eas build --profile preview --platform ios --local",
    "build:preview:android:local": "eas build --profile preview --platform android --local",
    "build:production:ios": "eas build --profile production --platform ios",
    "build:production:android": "eas build --profile production --platform android",
    "brand:icon-source": "tsx scripts/generate-icon-source.ts",
    "brand:generate": "tsx scripts/generate-icon-source.ts && tsx scripts/generate-brand-assets.ts",
    "lint": "eslint src app.config.ts env.ts .maestro",
    "lint:fix": "eslint src app.config.ts env.ts .maestro --fix",
    "format": "pnpm lint:fix",
    "type-check": "tsc --noemit",
    "lint:translations": "eslint ./src/translations/ --fix --ext .json",
    "test": "jest",
    "check-all": "pnpm run lint && pnpm run type-check && pnpm run lint:translations && pnpm run test",
    "test:ci": "pnpm run test --coverage",
    "test:watch": "pnpm run test --watch",
    "install-maestro": "curl -Ls 'https://get.maestro.mobile.dev' | bash",
    "e2e-test": "PATH=\"$HOME/.maestro/bin:$PATH\" maestro test .maestro/app/backgammon-smoke.yaml -e APP_ID=com.backgammonmastermind.development",
    "e2e-smoke": "PATH=\"$HOME/.maestro/bin:$PATH\" maestro test .maestro/app/backgammon-smoke.yaml -e APP_ID=com.backgammonmastermind.development",
    "skills:update": "skills update",
    "device:open": "agent-device --session android open com.backgammonmastermind.development --platform android --relaunch",
    "device:snapshot": "agent-device --session android snapshot -i",
    "device:logs": "adb logcat -d -t 300 | grep -iE 'ReactNativeJS|ReferenceError|TypeError|Invariant' || true",
    "remotion:dev": "pnpm --dir remotion dev",
    "remotion:render": "pnpm --dir remotion render:all"
  },
  "dependencies": {
    "@expo-google-fonts/inter": "^0.4.2",
    "@expo/metro-runtime": "^56.0.13",
    "@expo/vector-icons": "^15.1.1",
    "@gorhom/bottom-sheet": "^5.2.8",
    "@react-navigation/native": "^7.2.5",
    "@shopify/flash-list": "2.0.2",
    "app-icon-badge": "^0.1.2",
    "expo": "~56.0.8",
    "expo-constants": "~56.0.16",
    "expo-crypto": "~56.0.4",
    "expo-dev-client": "~56.0.18",
    "expo-font": "~56.0.5",
    "expo-haptics": "~56.0.3",
    "expo-image": "~56.0.9",
    "expo-linking": "~56.0.13",
    "expo-localization": "~56.0.6",
    "expo-router": "~56.2.8",
    "expo-splash-screen": "~56.0.10",
    "expo-status-bar": "~56.0.4",
    "expo-system-ui": "~56.0.5",
    "expo-updates": "~56.0.17",
    "i18next": "^25.8.0",
    "lodash.memoize": "^4.1.2",
    "moti": "^0.30.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-error-boundary": "^6.1.0",
    "react-i18next": "^16.5.3",
    "react-native": "0.85.3",
    "react-native-edge-to-edge": "^1.7.0",
    "react-native-flash-message": "^0.4.2",
    "react-native-gesture-handler": "~2.31.2",
    "react-native-keyboard-controller": "^1.21.6",
    "react-native-mmkv": "~4.1.1",
    "react-native-nitro-modules": "^0.33.2",
    "react-native-reanimated": "~4.3.1",
    "react-native-restart": "0.0.27",
    "react-native-safe-area-context": "5.7.0",
    "react-native-screens": "^4.25.2",
    "react-native-svg": "~15.15.4",
    "react-native-url-polyfill": "^3.0.0",
    "react-native-web": "~0.21.2",
    "react-native-worklets": "^0.8.3",
    "tailwind-merge": "^3.4.0",
    "tailwind-variants": "^3.2.2",
    "uniwind": "^1.2.4",
    "zod": "^4.3.5",
    "zustand": "^5.0.10"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^7.2.0",
    "@babel/core": "^7.29.0",
    "@commitlint/cli": "^20.3.1",
    "@commitlint/config-conventional": "^20.3.1",
    "@eslint-react/eslint-plugin": "^2.7.2",
    "@expo/config": "~56.0.8",
    "@tailwindcss/cli": "^4.0.0",
    "@testing-library/react-native": "^13.3.3",
    "@types/i18n-js": "^4.0.1",
    "@types/invariant": "^2.2.37",
    "@types/jest": "^29.5.14",
    "@types/lodash.memoize": "^4.1.9",
    "@types/node": "^22.19.19",
    "@types/react": "~19.2.15",
    "agent-device": "0.15.2",
    "babel-plugin-module-resolver": "^5.0.2",
    "cross-env": "^10.1.0",
    "dotenv": "^17.2.3",
    "eslint": "^9.39.2",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-better-tailwindcss": "^4.0.1",
    "eslint-plugin-i18n-json": "^4.0.1",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-react-compiler": "19.1.0-rc.2",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.26",
    "eslint-plugin-testing-library": "^7.15.4",
    "eslint-plugin-unicorn": "^62.0.0",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "jest-expo": "~56.0.4",
    "jest-junit": "^16.0.0",
    "lint-staged": "^16.2.7",
    "np": "^10.3.0",
    "sharp": "^0.34.5",
    "tailwindcss": "4.1.18",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3"
  },
  "expo": {
    "doctor": {
      "reactNativeDirectoryCheck": {
        "listUnknownPackages": false,
        "exclude": [
          "react-native-restart"
        ]
      }
    },
    "install": {
      "exclude": [
        "eslint-config-expo"
      ]
    }
  },
  "osMetadata": {
    "initVersion": "9.0.0"
  }
}
