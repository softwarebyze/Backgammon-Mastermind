{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "entry": [
    "src/app/**/*.{tsx,ts}",
    "app.config.ts",
    "env.ts"
  ],
  "project": ["src/**/*.{ts,tsx}"],
  "ignore": [
    "**/*.test.ts",
    "**/*.test.tsx",
    "jest-setup.ts",
    "scripts/**"
  ],
  "ignoreDependencies": [
    "@commitlint/cli",
    "@commitlint/config-conventional",
    "husky",
    "lint-staged",
    "jest-junit",
    "np"
  ]
}
